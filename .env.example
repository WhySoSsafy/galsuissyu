# Server only. Never prefix this secret with VITE_.
ODSAY_API_KEY=
# Domain registered for the ODsay web key, without protocol or trailing slash.
ODSAY_SERVICE_URI=galsuissyu-map.superstarrypassion.chatgpt.site
# Production transit API origin. Leave empty during local development (Vite proxy).
VITE_TRANSIT_API_URL=

# Korea Tourism Organization TourAPI service key (Decoding) from data.go.kr.
# Server only. Never prefix this secret with VITE_.
# KorService2 (national tourism info) works with this key. KorWithService2 (barrier-free travel
# info) needs a separate application on the portal; until then it returns
# SERVICE_KEY_IS_NOT_REGISTERED_ERROR.
TOUR_API_KEY=
