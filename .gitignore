node_modules/
dist/
.sites-runtime/
.env
.env.*
!.env.example
*.log
.wrangler/
# GitHub collaborators restore these large generated assets with assets:restore.
# Existing Sites-tracked copies remain tracked.
# Git will not descend into an excluded directory, so the path down to the one file we do keep has
# to be opened level by level.
/public/*
!/public/brand/
/public/brand/*
!/public/brand/mark-16.png
!/public/brand/mark-32.png
!/public/brand/mark-64.png
!/public/brand/mark-128.png
!/public/brand/mark-180.png
!/public/brand/mark-192.png
!/public/brand/mark-256.png
!/public/data/
/public/data/*
!/public/data/tour-places.json
!/public/data/bus-stops.json
# Real provider answers for the journeys people ask for, so the simulation does not depend on
# someone else's uptime or on an allowance that runs out mid-session.
!/public/data/recorded-routes.json
!/public/assets/
/public/assets/*
!/public/assets/survey/
/public/assets/survey/*
!/public/assets/survey/README.md
!/public/assets/survey/wheelchair.webp
!/public/assets/survey/ramp.webp
!/public/assets/survey/rest.webp
!/public/assets/survey/stroller.webp
!/public/assets/survey/vision.webp
!/public/assets/survey/hearing.webp
!/public/assets/survey/family.webp
!/public/assets/survey/step-companion.webp
!/public/assets/survey/step-route.webp
!/public/assets/survey/step-surface.webp
!/public/assets/survey/slope.webp
!/public/assets/survey/surface.webp
# The opening film. It is not in the restore manifest, so without these it simply would not exist
# in a deployed build and the drawn placeholder would stand in for it. It lives outside /assets/
# because that path is served immutable for a year, and its name never changes.
!/public/film/
/public/film/*
!/public/film/intro.mp4
!/public/film/intro-poster.jpg
/research/
.vercel
